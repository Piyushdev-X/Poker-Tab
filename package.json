{
  "name": "pokertab",
  "version": "1.0.0",
  "description": "PokerTab — Production-Ready Real-Time Texas Hold'em Engine & Team Settlement Ledger",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "test": "node -e \"import('./server/handEvaluator.js').then(m => console.log('HandEvaluator OK'))\""
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "realtime",
    "socketio",
    "react",
    "ledger"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
