# ========================================================
# PokerTab Environment Variables (All Optional)
# ========================================================

# Server Configuration
# PORT: Port where the Node.js / Socket.io server listens (defaults to 3001)
PORT=3001

# Client Configuration (used when client is hosted separately from server, e.g. on Vercel)
# VITE_SOCKET_URL: Full URL of your deployed Socket.io server (e.g. https://pokertab-server.railway.app)
# If omitted:
# - In local development: defaults to http://localhost:3001
# - In unified production (server serves client/dist): defaults to the current origin (/)
# VITE_SOCKET_URL=http://localhost:3001
